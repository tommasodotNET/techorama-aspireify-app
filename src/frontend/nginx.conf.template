server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    location = /health {
        proxy_pass ${API_UPSTREAM}/health;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
